        <input type="search" id="entSearch" placeholder="Cerca una entitat o codi…">
      </div>
      <div id="entitatsGroups"></div>
    </div>
    <div class="panel">
      <h3>🖋️ Secretaris de la Comissió</h3>
      <p class="secretaris-note" id="secretarisNote"></p>
    </div>
  </section>

</main>

<footer class="app-footer">
