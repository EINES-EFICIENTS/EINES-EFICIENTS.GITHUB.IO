    </div>
    <div class="people-grid" id="peopleGrid"></div>
  </section>

  <!-- ================= GLOSSARI ================= -->
  <section class="view" id="view-glossari" role="tabpanel" aria-labelledby="tab-glossari">
    <div class="section-head">
      <h2>📖 Glossari i entitats</h2>
      <p class="section-lede">Significat dels tipus d'expedient i estats, i llistat de les entitats que poden sol·licitar informe a la Comissió.</p>
    </div>

    <div class="panel">
      <h3>🏷️ Tipus d'expedient</h3>
      <div class="legend-grid" id="legendTipus"></div>
    </div>
    <div class="panel">
      <h3>⚖️ Situació</h3>
      <div class="legend-grid" id="legendSituacio"></div>
    </div>
    <div class="panel">
      <h3>🏛️ Entitats (<span id="entitatsCount"></span>)</h3>
