/* ============================================================
   HELPERS
   ============================================================ */
const MESOS = ['gener','febrer','març','abril','maig','juny','juliol','agost','setembre','octubre','novembre','desembre'];

function escapeHtml(str){
  if(str===null||str===undefined) return '';
  return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function stripDiacritics(str){
  return String(str||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
}
function fmtDate(iso, opts){
  if(!iso) return null;
  const [y,m,d] = iso.split('-').map(Number);
  if(opts && opts.short) return `${d} ${MESOS[m-1].slice(0,3)}. ${y}`;
  return `${d} de ${MESOS[m-1]} de ${y}`;
}
function fmtCost(n){
  if(n===null||n===undefined) return null;
  return n.toLocaleString('ca-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
}
function fmtCostShort(n){
  if(n===null||n===undefined) return '—';
  if(Math.abs(n) >= 1000000) return (n/1000000).toLocaleString('ca-ES',{maximumFractionDigits:1})+' M€';
  if(Math.abs(n) >= 1000) return (n/1000).toLocaleString('ca-ES',{maximumFractionDigits:0})+' mil €';
  return n.toLocaleString('ca-ES',{maximumFractionDigits:0})+' €';
}
function normEntity(str){
  return stripDiacritics(str).replace(/\s+/g,' ').replace(/[().,]/g,'').trim();
}
function findEntitat(nom){
  if(!nom) return null;
  const n = normEntity(nom);
  let m = DATA.entitats.find(e => normEntity(e.nom) === n);
  if(m) return m;
  m = DATA.entitats.find(e => normEntity(e.nom).startsWith(n) || n.startsWith(normEntity(e.nom)));
  return m || null;
}
function tipusEntitatNom(codi){
  const m = DATA.tipusEntitat.find(t => t.codi === codi);
  return m ? m.nom : codi;
}

/* status: derive an app-level "estat" bucket per expedient */
function estatExpedient(e){
  const buit = !e.ens && !e.tipus && !e.cost && !e.observacions && !e.dotacio && !e.desdotacio;
  if(buit) return 'reservat';
  if(e.situacioNorm) return e.situacioNorm; // aprovat | pendent | retirat | rebutjat
  return 'sense';
}
const ESTAT_LABEL = {
  aprovat:'Aprovat', pendent:'Pendent', retirat:'Retirat', rebutjat:'Rebutjat',
  sense:'Sense classificar', reservat:'Número reservat'
};
const ESTAT_COLOR = {
  aprovat:'var(--green)', pendent:'var(--ochre)', retirat:'var(--gray)',
  rebutjat:'var(--red)', sense:'var(--teal)', reservat:'var(--ink-faint)'
};
function pill(estat, opts){
  const cls = 'pill pill--' + estat + (opts&&opts.stamp ? ' stamp' : '');
  return `<span class="${cls}">${ESTAT_LABEL[estat]}</span>`;
}

const EXP_TRAMITATS = DATA.expedients.filter(e => estatExpedient(e) !== 'reservat');
const EXP_RESERVATS = DATA.expedients.filter(e => estatExpedient(e) === 'reservat');

/* ============================================================
   TABS
   ============================================================ */
function initTabs(){
  const btns = document.querySelectorAll('.tab-btn');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view;
      btns.forEach(b => b.setAttribute('aria-selected', b===btn ? 'true':'false'));
      document.querySelectorAll('.view').forEach(v => v.classList.remove('is-active'));
      document.getElementById('view-'+view).classList.add('is-active');
      window.scrollTo({top:0, behavior: (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto':'smooth')});
      history.replaceState(null,'','#'+view);
    });
  });
  const initial = (location.hash||'').replace('#','');
  const match = [...btns].find(b => b.dataset.view === initial);
  if(match) match.click();
}

/* ============================================================
   HEADER META
   ============================================================ */
function renderHeaderMeta(){
  const upd = DATA.meta.sourceModified ? `Dades actualitzades el ${fmtDate(DATA.meta.sourceModified)}` : '';
  document.getElementById('metaUpdated').textContent = upd;
  document.getElementById('metaCounts').textContent =
    `${EXP_TRAMITATS.length} expedients tramitats · ${DATA.reunions.length} reunions · ${DATA.membres.length} membres`;
  document.getElementById('countExpedients').textContent = DATA.expedients.length;
  document.getElementById('countReunions').textContent = DATA.reunions.length;
}

/* ============================================================
   RESUM (dashboard)
   ============================================================ */
function renderResum(){
  const vacants = DATA.membres.filter(m=>!m.nom).length;
  const costos = EXP_TRAMITATS.filter(e=>e.cost);
  const sumCost = costos.reduce((a,e)=>a+e.cost,0);

  document.getElementById('statGrid').innerHTML = `
    <div class="stat-card">
      <div class="stat-num tabular">${EXP_TRAMITATS.length}</div>
      <div class="stat-label">Expedients tramitats</div>
      <div class="stat-sub">${EXP_RESERVATS.length} números reservats sense iniciar</div>
    </div>
    <div class="stat-card">
      <div class="stat-num tabular">${fmtCostShort(sumCost)}</div>
      <div class="stat-label">Cost total gestionat</div>
      <div class="stat-sub">en ${costos.length} expedients amb cost registrat</div>
    </div>
    <div class="stat-card">
      <div class="stat-num tabular">${DATA.reunions.length}</div>
      <div class="stat-label">Reunions registrades</div>
      <div class="stat-sub">des de ${DATA.reunions[DATA.reunions.length-1]?.data?.slice(0,4)||'2017'}</div>
    </div>
    <div class="stat-card">
      <div class="stat-num tabular">${DATA.membres.length}</div>
      <div class="stat-label">Membres de la comissió</div>
      <div class="stat-sub">${vacants ? vacants+' seient vacant' : 'composició completa'}</div>
    </div>`;

  // --- situacio chart (among tramitats) ---
  const sitCounts = {};
  EXP_TRAMITATS.forEach(e=>{ const s=estatExpedient(e); sitCounts[s]=(sitCounts[s]||0)+1; });
  const sitOrder = ['aprovat','pendent','sense','retirat','rebutjat'];
  const maxSit = Math.max(1,...sitOrder.map(s=>sitCounts[s]||0));
  document.getElementById('chartSituacio').innerHTML = sitOrder.filter(s=>sitCounts[s]).map(s=>`
    <div class="bar-row">
      <div class="bar-label"><span>${ESTAT_LABEL[s]}</span><span class="n tabular">${sitCounts[s]}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${(sitCounts[s]/maxSit*100).toFixed(0)}%; background:${ESTAT_COLOR[s]}"></div></div>
    </div>`).join('');
  document.getElementById('chartSituacioNote').textContent = `Sobre ${EXP_TRAMITATS.length} expedients amb tramitació iniciada.`;

  // --- tipus chart ---
  const tipCounts = {};
  EXP_TRAMITATS.forEach(e=>{ if(e.tipus) tipCounts[e.tipus]=(tipCounts[e.tipus]||0)+1; });
  const tipEntries = Object.entries(tipCounts).sort((a,b)=>b[1]-a[1]);
  const maxTip = Math.max(1,...tipEntries.map(x=>x[1]));
  document.getElementById('chartTipus').innerHTML = tipEntries.map(([t,n])=>`
    <div class="bar-row">
      <div class="bar-label"><span>${escapeHtml(t)}</span><span class="n tabular">${n}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${(n/maxTip*100).toFixed(0)}%"></div></div>
    </div>`).join('');

  // --- reunions per any i modalitat (stacked) ---
  const modColors = {'Presencial':'var(--teal)','Videoconferència':'var(--ochre)','Teams':'var(--gray)'};
  const years = {};
  DATA.reunions.forEach(r=>{
    if(!r.data) return;
    const y = r.data.slice(0,4);
    years[y] = years[y] || {};
    years[y][r.modalitat] = (years[y][r.modalitat]||0)+1;
  });
  const yearKeys = Object.keys(years).sort();
  const maxYearTotal = Math.max(1,...yearKeys.map(y=>Object.values(years[y]).reduce((a,b)=>a+b,0)));
  document.getElementById('chartAnys').innerHTML = yearKeys.map(y=>{
    const mods = years[y];
    const total = Object.values(mods).reduce((a,b)=>a+b,0);
    const widthPct = (total/maxYearTotal*100).toFixed(0);
    const segs = Object.entries(mods).map(([m,n])=>`<div class="stacked-seg" style="width:${(n/total*100).toFixed(0)}%; background:${modColors[m]||'var(--ink-faint)'}" title="${m}: ${n}"></div>`).join('');
    return `<div class="year-chart-row">
      <div class="yc-label"><span>${y}</span><span class="n tabular">${total} reunió${total!==1?'ns':''}</span></div>
      <div class="stacked-bar" style="width:${widthPct}%">${segs}</div>
    </div>`;
  }).join('');
  document.getElementById('chartAnysLegend').innerHTML = Object.entries(modColors).map(([m,c])=>
    `<span><span class="sw" style="background:${c}"></span>${m}</span>`).join('');

  // --- top entitats ---
  const ensCounts = {};
  EXP_TRAMITATS.forEach(e=>{ if(e.ens) ensCounts[e.ens]=(ensCounts[e.ens]||0)+1; });
  const ensEntries = Object.entries(ensCounts).sort((a,b)=>b[1]-a[1]).slice(0,7);
  const maxEns = Math.max(1,...ensEntries.map(x=>x[1]));
  document.getElementById('chartEntitats').innerHTML = ensEntries.map(([n,c])=>`
    <div class="bar-row">
      <div class="bar-label"><span>${escapeHtml(n)}</span><span class="n tabular">${c}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${(c/maxEns*100).toFixed(0)}%; background:var(--ochre)"></div></div>
    </div>`).join('');
}

/* ============================================================
   EXPEDIENTS
   ============================================================ */
const expState = { q:'', tipus:'', ens:'', estat:'', sort:'num-desc' };

function expMatches(e){
  const estat = estatExpedient(e);
  if(expState.estat && estat !== expState.estat) return false;
  if(expState.tipus && e.tipus !== expState.tipus) return false;
  if(expState.ens && e.ens !== expState.ens) return false;
  if(expState.q){
    const hay = stripDiacritics([e.expedient,e.ens,e.tipus,e.observacions,e.dotacio,e.desdotacio,e.ml,e.situacio].filter(Boolean).join(' | '));
    if(!hay.includes(stripDiacritics(expState.q))) return false;
  }
  return true;
}
function expSortFn(a,b){
  switch(expState.sort){
    case 'num-asc': return a.expedient.localeCompare(b.expedient, 'ca', {numeric:true});
    case 'cost-desc': return (b.cost||-1) - (a.cost||-1);
    case 'data-desc': return (b.dataEntrada||'').localeCompare(a.dataEntrada||'');
    default: return b.expedient.localeCompare(a.expedient, 'ca', {numeric:true});
  }
}

function expedientRowHtml(e){
  const estat = estatExpedient(e);
  const reservat = estat === 'reservat';
  const entitat = findEntitat(e.ens);
  const id = 'exp-'+e.expedient.replace(/[^a-zA-Z0-9]/g,'-');
  const tags = [
    e.tipus ? `<span class="pill" style="color:var(--ink-muted);background:var(--surface-alt);border-color:var(--border-strong)">${escapeHtml(e.tipus)}</span>` : '',
    pill(estat)
  ].join('');

  let detail = '';
  if(!reservat){
    const rows = [];
    if(e.dataEntrada) rows.push(['Data d\'entrada', fmtDate(e.dataEntrada)]);
    if(entitat) rows.push(['Tipus d\'entitat', tipusEntitatNom(entitat.tipusCodi) + (entitat.codi? ' · '+entitat.codi:'')]);
    if(e.dotacio) rows.push(['Dotació', escapeHtml(e.dotacio)]);
    if(e.desdotacio) rows.push(['Des-dotació', escapeHtml(e.desdotacio)]);
    if(e.dataInformeDGP) rows.push(['Informe DGP', fmtDate(e.dataInformeDGP)]);
    if(e.ml) rows.push(['ML', escapeHtml(e.ml)]);
    if(e.sessioAprovacio) rows.push(['Sessió', `<button class="link-chip" data-goto-reunio="${escapeHtml(e.sessioAprovacio)}">📅 ${escapeHtml(e.sessioAprovacio)}</button>`]);
    if(e.observacions) rows.push(['Observacions', escapeHtml(e.observacions), true]);
    detail = `<dl class="detail-grid">${rows.map(([k,v,full])=>`<div${full?' class="full"':''}><dt>${k}</dt><dd>${v}</dd></div>`).join('')}</dl>`;
    if(!rows.length) detail = `<p class="empty-note">Sense més detall registrat per a aquest expedient.</p>`;
  } else {
    detail = `<p class="empty-note">Número d'expedient reservat; encara no s'hi ha registrat tramitació.</p>`;
  }

  return `<details class="exp-row${reservat?' is-reservat':''}" id="${id}">
    <summary>
      <span class="exp-id tabular">${escapeHtml(e.expedient)}</span>
      <span class="exp-ens">${e.ens ? escapeHtml(e.ens) : 'Sense assignar'}</span>
      <span class="exp-cost tabular">${e.cost!=null ? fmtCost(e.cost) : '—'}</span>
      <span class="exp-tags">${tags}</span>
      <span class="exp-date tabular">${e.dataEntrada ? fmtDate(e.dataEntrada,{short:true}) : ''}</span>
      <span class="exp-chevron">▸</span>
    </summary>
    <div class="exp-detail">${detail}</div>
  </details>`;
}

function renderExpedientsControls(){
  const tipusSel = document.getElementById('expTipusFilter');
  DATA.tipusExpedient.forEach(t=>{
    const o = document.createElement('option'); o.value=t; o.textContent=t; tipusSel.appendChild(o);
  });
  const ensSel = document.getElementById('expEntitatFilter');
  const ensList = [...new Set(DATA.expedients.map(e=>e.ens).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ca'));
  ensList.forEach(n=>{
    const o = document.createElement('option'); o.value=n; o.textContent=n; ensSel.appendChild(o);
  });

  const chipDefs = [
    ['', 'Tots', null],
    ['aprovat','Aprovat','var(--green)'], ['pendent','Pendent','var(--ochre)'],
    ['sense','Sense classificar','var(--teal)'], ['retirat','Retirat','var(--gray)'],
    ['rebutjat','Rebutjat','var(--red)'], ['reservat','Reservats','var(--ink-faint)'],
  ];
  const chipsEl = document.getElementById('expStatusChips');
  chipsEl.innerHTML = chipDefs.map(([val,label,color])=>
    `<button class="chip" data-estat="${val}" aria-pressed="${val===''?'true':'false'}">${color?`<span class="dot" style="background:${color}"></span>`:''}${label}</button>`).join('');
  chipsEl.querySelectorAll('.chip').forEach(chip=>{
    chip.addEventListener('click', ()=>{
      expState.estat = chip.dataset.estat;
      chipsEl.querySelectorAll('.chip').forEach(c=>c.setAttribute('aria-pressed', c===chip?'true':'false'));
      renderExpedientsList();
    });
  });

  document.getElementById('expSearch').addEventListener('input', e=>{ expState.q = e.target.value; renderExpedientsList(); });
  tipusSel.addEventListener('change', e=>{ expState.tipus = e.target.value; renderExpedientsList(); });
  ensSel.addEventListener('change', e=>{ expState.ens = e.target.value; renderExpedientsList(); });
  document.getElementById('expSort').addEventListener('change', e=>{ expState.sort = e.target.value; renderExpedientsList(); });

  document.getElementById('expList').addEventListener('click', e=>{
    const btn = e.target.closest('[data-goto-reunio]');
    if(btn){
      e.preventDefault();
      document.querySelector('.tab-btn[data-view="reunions"]').click();
      document.getElementById('reuSearch').value = '';
      reuState.q=''; reuState.year=''; document.getElementById('reuYearFilter').value='';
      renderReunionsList();
      const target = document.getElementById('reunio-'+btn.dataset.gotoReunio.replace(/[^a-zA-Z0-9]/g,'-'));
      if(target){
        target.open = true;
        target.scrollIntoView({behavior:'smooth', block:'center'});
        target.style.outline = '2.5px solid var(--teal)';
        setTimeout(()=>target.style.outline='', 1600);
      }
    }
  });
}

function renderExpedientsList(){
  const filtered = DATA.expedients.filter(expMatches).sort(expSortFn);
  document.getElementById('expList').innerHTML = filtered.map(expedientRowHtml).join('') ||
    `<p class="empty-note" style="padding:20px 16px;">Cap expedient coincideix amb la cerca o els filtres.</p>`;
  document.getElementById('expResultCount').textContent = `${filtered.length} de ${DATA.expedients.length} expedients`;
}

/* ============================================================
   REUNIONS
   ============================================================ */
const reuState = { q:'', year:'' };

function reunioMatches(r){
  if(reuState.year && (r.data||'').slice(0,4) !== reuState.year) return false;
  if(reuState.q){
    const hay = stripDiacritics([r.id,r.lloc,r.secretari,r.modalitat, ...(r.assumptes||[]).map(a=>a.text)].filter(Boolean).join(' | '));
    if(!hay.includes(stripDiacritics(reuState.q))) return false;
  }
  return true;
}

function reunioCardHtml(r){
  const relatedExp = EXP_TRAMITATS.filter(e => e.sessioAprovacio === r.id);
  const domId = 'reunio-'+r.id.replace(/[^a-zA-Z0-9]/g,'-');
  const agenda = (r.assumptes||[]).length
    ? `<ol class="agenda-list">${r.assumptes.map(a=>`<li>${escapeHtml(a.text)}</li>`).join('')}</ol>`
    : `<p class="empty-note">No hi ha ordre del dia detallat per a aquesta sessió en el registre.</p>`;
  const relatedHtml = relatedExp.length ? `<div class="related-exp">
      <h4>Expedients aprovats en aquesta sessió (${relatedExp.length})</h4>
      <div class="chip-group">${relatedExp.map(e=>`<button class="link-chip" data-goto-exp="${e.expedient}">🗂️ ${escapeHtml(e.expedient)} — ${escapeHtml((e.ens||'').split(' ').slice(0,4).join(' '))}${e.ens && e.ens.split(' ').length>4?'…':''}</button>`).join('')}</div>
    </div>` : '';
  return `<details class="meeting-card" id="${domId}">
    <summary>
      <span class="mc-id tabular">${escapeHtml(r.id)}</span>
      <span class="mc-date">${r.data ? fmtDate(r.data) : 'Data no registrada'}</span>
      ${r.modalitat ? `<span class="mc-tag">${escapeHtml(r.modalitat)}</span>` : ''}
      <span class="mc-meta">
        ${r.horaInici ? `🕐 ${r.horaInici}${r.horaFinal? '–'+r.horaFinal:''}` : ''}
        ${r.lloc ? `· 📍 ${escapeHtml(r.lloc)}` : ''}
        ${r.secretari ? `· 🖋️ ${escapeHtml(r.secretari)}` : ''}
      </span>
      <span class="mc-agenda-count">${(r.assumptes||[]).length} assumpte${(r.assumptes||[]).length!==1?'s':''}</span>
    </summary>
    <div class="meeting-detail">${agenda}${relatedHtml}</div>
  </details>`;
}

function renderReunionsControls(){
  const yearSel = document.getElementById('reuYearFilter');
  const years = [...new Set(DATA.reunions.map(r=>(r.data||'').slice(0,4)).filter(Boolean))].sort().reverse();
  years.forEach(y=>{ const o=document.createElement('option'); o.value=y; o.textContent=y; yearSel.appendChild(o); });
  document.getElementById('reuSearch').addEventListener('input', e=>{ reuState.q=e.target.value; renderReunionsList(); });
  yearSel.addEventListener('change', e=>{ reuState.year=e.target.value; renderReunionsList(); });

  document.getElementById('reuList').addEventListener('click', e=>{
    const btn = e.target.closest('[data-goto-exp]');
    if(btn){
      e.preventDefault();
      document.querySelector('.tab-btn[data-view="expedients"]').click();
      expState.q=''; document.getElementById('expSearch').value='';
      renderExpedientsList();
      const target = document.getElementById('exp-'+btn.dataset.gotoExp.replace(/[^a-zA-Z0-9]/g,'-'));
      if(target){
        target.open = true;
        target.scrollIntoView({behavior:'smooth', block:'center'});
        target.style.outline = '2.5px solid var(--teal)';
        setTimeout(()=>target.style.outline='', 1600);
      }
    }
  });
}

function renderReunionsList(){
  const filtered = DATA.reunions.filter(reunioMatches);
  const byYear = {};
  filtered.forEach(r=>{ const y=(r.data||'').slice(0,4)||'Sense data'; (byYear[y]=byYear[y]||[]).push(r); });
  const yearKeys = Object.keys(byYear).sort().reverse();
  document.getElementById('reuList').innerHTML = yearKeys.map(y=>`
    <div class="year-group">
      <div class="year-group-head"><h3>${y}</h3><span class="n">${byYear[y].length} reunió${byYear[y].length!==1?'ns':''}</span></div>
      ${byYear[y].map(reunioCardHtml).join('')}
    </div>`).join('') || `<p class="empty-note">Cap reunió coincideix amb la cerca.</p>`;
  document.getElementById('reuResultCount').textContent = `${filtered.length} de ${DATA.reunions.length} reunions`;
}

