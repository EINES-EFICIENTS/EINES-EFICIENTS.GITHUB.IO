        <option value="num-asc">Núm. expedient (antic primer)</option>
        <option value="cost-desc">Cost (major a menor)</option>
        <option value="data-desc">Data d'entrada (recent primer)</option>
      </select>
    </div>
    <div class="chip-group" id="expStatusChips"></div>
    <p class="result-count" id="expResultCount" aria-live="polite"></p>

    <div class="rows">
      <div class="row-head" aria-hidden="true">
        <span>Expedient</span><span>Ens</span><span>Cost</span><span>Tipus / situació</span><span>Data</span><span></span>
      </div>
      <div id="expList"></div>
    </div>
  </section>

  <!-- ================= REUNIONS ================= -->
  <section class="view" id="view-reunions" role="tabpanel" aria-labelledby="tab-reunions">
    <div class="section-head">
      <h2>📅 Reunions</h2>
