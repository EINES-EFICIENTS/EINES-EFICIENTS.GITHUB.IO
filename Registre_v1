/* ============================================================
   GLOSSARI
   ============================================================ */
const TIPUS_DESC = {
  'Dotació': "Creació o assignació pressupostària d'un lloc de treball.",
  'Des-dotació': "Retirada d'un lloc de treball existent.",
  'Dotació-desdotació': "Es crea un lloc de treball i, alhora, se'n retira un altre (moviment compensat).",
  'Adequació retributiva': "Ajust del complement o del nivell retributiu d'un lloc ja existent.",
  'Supressió': "Eliminació d'un lloc de treball.",
  'Acord': "Acord singular adoptat directament per la Comissió.",
  'Altres': "Assumptes que no encaixen en cap de les categories anteriors."
};
const SITUACIO_DESC = {
  'aprovat': "La Comissió ha aprovat l'expedient.",
  'pendent': "Encara no s'ha resolt; és pendent de decisió.",
  'rebutjat': "La Comissió no ha aprovat la sol·licitud.",
  'retirat': "L'ens sol·licitant ha retirat l'expedient abans de resoldre's."
};

function renderGlossari(){
  document.getElementById('legendTipus').innerHTML = DATA.tipusExpedient.map(t=>`
    <div class="legend-item">
      <span class="pill" style="color:var(--ink-muted);background:var(--surface-alt);border-color:var(--border-strong)">${escapeHtml(t)}</span>
      <p>${TIPUS_DESC[t]||''}</p>
    </div>`).join('');

  document.getElementById('legendSituacio').innerHTML = DATA.situacions.map(s=>{
    const norm = s.toLowerCase();
    return `<div class="legend-item">${pill(norm)}<p>${SITUACIO_DESC[norm]||''}</p></div>`;
  }).join('');

  const entCount = document.getElementById('entitatsCount');
  entCount.textContent = DATA.entitats.length;

  function renderEntitats(filterQ){
    const groups = {};
    DATA.entitats.forEach(e=>{ (groups[e.tipusCodi]=groups[e.tipusCodi]||[]).push(e); });
    const order = DATA.tipusEntitat.map(t=>t.codi);
    const html = order.filter(c=>groups[c]).map(codi=>{
      let items = groups[codi].slice().sort((a,b)=>a.nom.localeCompare(b.nom,'ca'));
      if(filterQ){
        const nq = stripDiacritics(filterQ);
        items = items.filter(e => stripDiacritics(e.nom+' '+e.codi).includes(nq));
      }
      if(!items.length) return '';
      return `<div class="entity-group">
        <div class="entity-group-head"><span class="tag">${tipusEntitatNom(codi)}</span><span class="n" style="font-size:.76rem;color:var(--ink-faint)">${items.length}</span></div>
        <ul class="entity-list">${items.map(e=>`<li><span>${escapeHtml(e.nom)}</span><span class="code">${escapeHtml(e.codi)}</span></li>`).join('')}</ul>
      </div>`;
    }).join('');
    document.getElementById('entitatsGroups').innerHTML = html || `<p class="empty-note">Cap entitat coincideix amb la cerca.</p>`;
  }
  renderEntitats('');
  document.getElementById('entSearch').addEventListener('input', e=>renderEntitats(e.target.value));

  document.getElementById('secretarisNote').innerHTML =
    DATA.secretaris.map(s=>`<strong>${escapeHtml(s)}</strong>`).join(', ') +
    '. Persona encarregada de la convocatòria, l\'acta i el seguiment dels expedients de cada sessió.';
}

/* ============================================================
   PWA — manifest + service worker (progressive enhancement)
   ============================================================ */
function initPWA(){
  try{
    const ICON = "data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2064%2064%27%3E%3Crect%20width%3D%2764%27%20height%3D%2764%27%20fill%3D%27%230B6E6E%27%2F%3E%3Crect%20x%3D%2715%27%20y%3D%2713%27%20width%3D%2734%27%20height%3D%2740%27%20rx%3D%273%27%20fill%3D%27none%27%20stroke%3D%27%23F4F7F6%27%20stroke-width%3D%273.2%27%2F%3E%3Cline%20x1%3D%2722%27%20y1%3D%2724%27%20x2%3D%2742%27%20y2%3D%2724%27%20stroke%3D%27%23F4F7F6%27%20stroke-width%3D%273.2%27%20stroke-linecap%3D%27round%27%2F%3E%3Cline%20x1%3D%2722%27%20y1%3D%2732.5%27%20x2%3D%2742%27%20y2%3D%2732.5%27%20stroke%3D%27%23F4F7F6%27%20stroke-width%3D%273.2%27%20stroke-linecap%3D%27round%27%2F%3E%3Cline%20x1%3D%2722%27%20y1%3D%2741%27%20x2%3D%2735%27%20y2%3D%2741%27%20stroke%3D%27%23F4F7F6%27%20stroke-width%3D%273.2%27%20stroke-linecap%3D%27round%27%2F%3E%3C%2Fsvg%3E";
    const manifest = {
      name: "Comissió Interdepartamental de Retribucions",
      short_name: "Retribucions",
      description: "Registre d'expedients, reunions i membres de la Comissió Interdepartamental de Retribucions.",
      start_url: location.pathname,
      scope: location.pathname,
      display: "standalone",
      background_color: "#F4F7F6",
      theme_color: "#0B6E6E",
      lang: "ca",
      icons: [{ src: ICON, sizes: "any", type: "image/svg+xml", purpose: "any" }]
    };
    const blob = new Blob([JSON.stringify(manifest)], {type:'application/manifest+json'});
    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = URL.createObjectURL(blob);
    document.head.appendChild(link);
  }catch(err){ /* manifest is a progressive enhancement; ignore failures */ }

  if('serviceWorker' in navigator && location.protocol.startsWith('http')){
    const swSource = `
      const CACHE = 'retribucions-v1';
      self.addEventListener('install', evt => { self.skipWaiting(); });
      self.addEventListener('activate', evt => { self.clients.claim(); });
      self.addEventListener('fetch', evt => {
        if(evt.request.method !== 'GET') return;
        evt.respondWith(
          caches.open(CACHE).then(async cache => {
            const cached = await cache.match(evt.request);
            const network = fetch(evt.request).then(resp => { cache.put(evt.request, resp.clone()); return resp; }).catch(()=>cached);
            return cached || network;
          })
        );
      });
    `;
    try{
      const swBlob = new Blob([swSource], {type:'text/javascript'});
      navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(()=>{});
    }catch(err){ /* offline caching is a bonus, not required */ }
  }
}

/* ============================================================
   INIT
   ============================================================ */
function init(){
  renderHeaderMeta();
  renderResum();
  renderExpedientsControls();
  renderExpedientsList();
  renderReunionsControls();
  renderReunionsList();
  renderMembres();
  renderGlossari();
  initTabs();
  initPWA();
}
document.addEventListener('DOMContentLoaded', init);
</script>
