    </div>
    <div class="toolbar">
      <div class="search-box">
        <label class="sr-only" for="reuSearch">Cerca reunions</label>
        <input type="search" id="reuSearch" placeholder="Cerca per lloc, secretari, assumpte…">
      </div>
      <select class="ctrl" id="reuYearFilter" aria-label="Filtra per any">
        <option value="">Tots els anys</option>
      </select>
    </div>
    <p class="result-count" id="reuResultCount" aria-live="polite"></p>
    <div id="reuList"></div>
  </section>

  <!-- ================= MEMBRES ================= -->
  <section class="view" id="view-membres" role="tabpanel" aria-labelledby="tab-membres">
