      </div>
      <div class="panel full">
        <h3>🏛️ Entitats amb més expedients tramitats</h3>
        <div id="chartEntitats"></div>
      </div>
    </div>
  </section>

  <!-- ================= EXPEDIENTS ================= -->
  <section class="view" id="view-expedients" role="tabpanel" aria-labelledby="tab-expedients">
    <div class="section-head">
      <h2>🗂️ Expedients</h2>
