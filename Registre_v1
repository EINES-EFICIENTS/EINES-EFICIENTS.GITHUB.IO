<style>
/* ============================================================
   COMISSIÓ INTERDEPARTAMENTAL DE RETRIBUCIONS — design tokens
   ============================================================ */
:root{
  --bg: #F4F7F6;
  --surface: #FFFFFF;
  --surface-alt: #EDF3F2;
  --border: #DCE6E4;
  --border-strong: #C3D2CF;
  --ink: #12262A;
  --ink-muted: #55696A;
  --ink-faint: #8B9B99;

  --teal: #0B6E6E;
  --teal-dark: #084F4F;
  --teal-light: #E3F0EF;

  --ochre: #B8791F;
  --ochre-light: #FBF0DE;

  --green: #2E7D4F;
  --green-light: #E4F3E9;

  --red: #B33F3F;
  --red-light: #F8E9E9;

  --gray: #5E6E6C;
  --gray-light: #E9EDEC;

  --font-display: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  --font-body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;

  --radius-s: 6px;
  --radius-m: 10px;
  --radius-l: 16px;
  --shadow-card: 0 1px 2px rgba(18,38,42,0.06), 0 4px 14px rgba(18,38,42,0.05);
  --container: 1080px;
}

*, *::before, *::after{ box-sizing: border-box; }
html{ -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior: auto; }
  *, *::before, *::after{ animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
}

body{
  margin: 0;
  background: var(--bg);
  background-image:
    radial-gradient(circle at 1px 1px, rgba(18,38,42,0.05) 1px, transparent 0);
  background-size: 22px 22px;
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 15.5px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

h1,h2,h3,h4{ font-family: var(--font-display); font-weight: 600; line-height: 1.2; margin: 0; color: var(--ink); }
p{ margin: 0 0 0.7em; }
a{ color: var(--teal-dark); text-decoration-thickness: 1.5px; text-underline-offset: 2px; }
a:hover{ color: var(--teal); }
button{ font-family: inherit; }
::selection{ background: var(--teal); color: #fff; }

.sr-only{
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

:focus-visible{ outline: 2.5px solid var(--teal); outline-offset: 2px; border-radius: 3px; }

.tabular{ font-variant-numeric: tabular-nums; }

/* ============================== APP HEADER ============================== */
.app-header{
  background: linear-gradient(175deg, var(--teal-dark), var(--teal) 130%);
  color: #F4F7F6;
  border-bottom: 3px double rgba(244,247,246,0.55);
  position: relative;
  overflow: hidden;
}
.app-header::after{
  content: "";
  position: absolute; inset: 0;
  background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.09) 1px, transparent 0);
  background-size: 16px 16px;
  pointer-events: none;
}
.app-header-inner{
  max-width: var(--container); margin: 0 auto;
  padding: 26px 20px 22px;
  position: relative; z-index: 1;
}
.eyebrow{
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.72rem; letter-spacing: 0.11em; text-transform: uppercase;
  font-weight: 600; color: rgba(244,247,246,0.82);
  background: rgba(244,247,246,0.13);
  border: 1px solid rgba(244,247,246,0.28);
  padding: 4px 10px; border-radius: 999px;
  margin-bottom: 14px;
}
.app-title{
  font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.15rem);
  color: #FBFDFC;
  margin: 0 0 6px;
  letter-spacing: -0.01em;
}
.app-subtitle{
  color: rgba(244,247,246,0.86);
  font-size: 0.98rem;
  max-width: 62ch;
  margin: 0;
}
.app-meta{
  margin-top: 16px;
  font-size: 0.78rem;
  color: rgba(244,247,246,0.68);
  display: flex; flex-wrap: wrap; gap: 4px 16px;
}

/* ============================== TABS ============================== */
.tabs-wrap{
  position: sticky; top: 0; z-index: 20;
  background: rgba(244,247,246,0.92);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border-strong);
}
.tabs{
  max-width: var(--container); margin: 0 auto;
  display: flex; gap: 2px;
  overflow-x: auto; -webkit-overflow-scrolling: touch;
  padding: 0 12px;
  scrollbar-width: thin;
}
.tabs::-webkit-scrollbar{ height: 5px; }
.tabs::-webkit-scrollbar-thumb{ background: var(--border-strong); border-radius: 4px; }
.tab-btn{
  flex: 0 0 auto;
  display: flex; align-items: center; gap: 7px;
  background: transparent; border: none;
  padding: 13px 14px 11px;
  font-size: 0.88rem; font-weight: 600; color: var(--ink-muted);
  cursor: pointer;
  border-bottom: 3px solid transparent;
  white-space: nowrap;
}
.tab-btn:hover{ color: var(--teal-dark); }
.tab-btn[aria-selected="true"]{ color: var(--teal-dark); border-bottom-color: var(--teal); }
.tab-btn .ico{ font-size: 1rem; }
.tab-count{
  font-size: 0.72rem; color: var(--ink-faint); font-weight: 500;
}
.tab-btn[aria-selected="true"] .tab-count{ color: var(--teal); }

/* ============================== LAYOUT ============================== */
main{ max-width: var(--container); margin: 0 auto; padding: 22px 20px 60px; }
.view{ display: none; }
.view.is-active{ display: block; animation: fadein 0.25s ease; }
@keyframes fadein{ from{opacity:0; transform: translateY(4px);} to{opacity:1; transform:none;} }

.section-head{ margin-bottom: 16px; }
.section-head h2{ font-size: 1.35rem; display:flex; align-items:center; gap:9px; }
.section-lede{ color: var(--ink-muted); font-size: 0.92rem; margin-top: 4px; max-width: 68ch; }

.panel{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-card);
  padding: 20px;
}
.panel + .panel{ margin-top: 16px; }
.panel h3{ font-size: 1rem; margin-bottom: 12px; display:flex; align-items:center; gap:8px; }
.panel-note{ font-size: 0.8rem; color: var(--ink-faint); margin-top: 10px; }

/* ============================== STAT CARDS ============================== */
.stat-grid{
  display: grid; gap: 12px;
  grid-template-columns: repeat(2, 1fr);
  margin-bottom: 16px;
}
.stat-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-m);
  padding: 16px 16px 14px;
  box-shadow: var(--shadow-card);
  border-top: 3px solid var(--teal);
}
.stat-card .stat-num{
  font-family: var(--font-display); font-weight: 700;
  font-size: 1.65rem; color: var(--teal-dark); line-height: 1.1;
}
.stat-card .stat-label{ font-size: 0.8rem; color: var(--ink-muted); margin-top: 4px; font-weight: 500;}
.stat-card .stat-sub{ font-size: 0.74rem; color: var(--ink-faint); margin-top: 5px; }

.charts-grid{ display: grid; gap: 16px; grid-template-columns: 1fr; }

/* ============================== BAR CHARTS (hand-rolled) ============================== */
.bar-row{ display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 4px 10px; align-items: center; padding: 6px 0; }
.bar-row .bar-label{ font-size: 0.82rem; color: var(--ink); grid-column: 1 / -1; display:flex; justify-content:space-between; gap: 8px;}
.bar-row .bar-label .n{ color: var(--ink-muted); font-weight: 600; font-size: 0.78rem; }
.bar-track{ grid-column: 1 / -1; background: var(--surface-alt); border-radius: 999px; height: 9px; overflow: hidden; }
.bar-fill{ height: 100%; border-radius: 999px; background: var(--teal); transition: width 0.5s ease; }
.bar-row + .bar-row{ border-top: 1px dashed var(--border); }

.stacked-bar{ display:flex; height: 22px; border-radius: 5px; overflow:hidden; background: var(--surface-alt); }
.stacked-seg{ height: 100%; }
.year-chart-row{ margin-bottom: 12px; }
.year-chart-row .yc-label{ display:flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 5px; }
.year-chart-row .yc-label .n{ font-weight: 700; color: var(--ink); }
.legend-inline{ display:flex; flex-wrap:wrap; gap: 10px 16px; margin-top: 12px; font-size: 0.76rem; color: var(--ink-muted); }
.legend-inline .sw{ display:inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }

/* ============================== TOOLBAR / FILTERS ============================== */
.toolbar{ display:flex; flex-wrap:wrap; gap: 10px; margin-bottom: 14px; align-items:center; }
.search-box{ position: relative; flex: 1 1 220px; }
.search-box input{
  width: 100%; padding: 10px 12px 10px 34px;
  border: 1.5px solid var(--border-strong); border-radius: var(--radius-s);
  font-size: 0.9rem; font-family: inherit; color: var(--ink);
  background: var(--surface);
}
.search-box input:focus{ border-color: var(--teal); outline: none; box-shadow: 0 0 0 3px var(--teal-light); }
.search-box::before{
  content: "🔍"; position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
  font-size: 0.85rem; opacity: 0.65; pointer-events: none;
}
select.ctrl{
  padding: 9px 30px 9px 12px; border: 1.5px solid var(--border-strong); border-radius: var(--radius-s);
  font-size: 0.86rem; font-family: inherit; color: var(--ink); background: var(--surface);
  appearance: none; -webkit-appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%), linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
  background-position: calc(100% - 15px) center, calc(100% - 10px) center; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat;
}
select.ctrl:focus{ border-color: var(--teal); outline: none; }
.chip-group{ display:flex; flex-wrap:wrap; gap: 6px; }
.chip{
  border: 1.5px solid var(--border-strong); background: var(--surface); color: var(--ink-muted);
  padding: 6px 12px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;
  display:flex; align-items:center; gap:6px;
}
.chip:hover{ border-color: var(--teal); color: var(--teal-dark); }
.chip[aria-pressed="true"]{ background: var(--teal); border-color: var(--teal); color: #fff; }
.chip .dot{ width:7px; height:7px; border-radius:50%; display:inline-block; }
.result-count{ font-size: 0.8rem; color: var(--ink-faint); margin: 2px 0 12px; }

/* ============================== STATUS PILL (stamp motif) ============================== */
.pill{
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  padding: 3px 9px 3px; border-radius: 5px;
  border: 1.5px solid currentColor;
  white-space: nowrap;
}
.pill--aprovat{ color: var(--green); background: var(--green-light); }
.pill--pendent{ color: var(--ochre); background: var(--ochre-light); }
.pill--retirat{ color: var(--gray); background: var(--gray-light); }
.pill--rebutjat{ color: var(--red); background: var(--red-light); }
.pill--sense{ color: var(--teal-dark); background: var(--teal-light); }
.pill--reservat{ color: var(--ink-faint); background: transparent; border-style: dashed; }
.pill.stamp{
  font-size: 0.78rem; padding: 5px 13px; border-width: 2px; border-radius: 6px;
  transform: rotate(-1.3deg);
}

/* ============================== DATA ROWS (table <-> card) ============================== */
.rows{ border: 1px solid var(--border); border-radius: var(--radius-m); overflow: hidden; background: var(--surface); }
.row-head{
  display: none;
  background: var(--surface-alt); font-size: 0.7rem; font-weight: 700;
  color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em;
  padding: 10px 16px;
}
.exp-row{ border-top: 1px solid var(--border); }
.exp-row:first-child{ border-top: none; }
.exp-row.is-reservat{ opacity: 0.72; }
.exp-row summary{
  list-style: none; cursor: pointer; padding: 12px 16px;
  display: grid; align-items: center; gap: 3px 10px;
  grid-template-columns: 1fr auto;
  grid-template-areas:
    "id chev"
    "ens ens"
    "tags cost"
    "date date";
}
.exp-row summary::-webkit-details-marker{ display:none; }
.exp-row summary:hover{ background: var(--surface-alt); }
.exp-id{ grid-area: id; font-weight: 700; color: var(--teal-dark); font-size: 0.84rem; }
.exp-ens{ grid-area: ens; font-size: 0.92rem; font-weight: 600; color: var(--ink); }
.exp-tags{ grid-area: tags; display:flex; flex-wrap:wrap; gap: 5px; align-items:center; }
.exp-cost{ grid-area: cost; justify-self: end; font-weight: 700; font-family: var(--font-display); color: var(--ink); font-size: 0.93rem; white-space: nowrap; }
.exp-date{ grid-area: date; font-size: 0.76rem; color: var(--ink-faint); }
.exp-chevron{ grid-area: chev; justify-self: end; color: var(--ink-faint); font-size: 0.75rem; transition: transform 0.2s ease; align-self: start; }
.exp-row[open] .exp-chevron{ transform: rotate(90deg); }
.exp-detail{ padding: 4px 16px 18px; border-top: 1px dashed var(--border); margin-top: 4px; }
.detail-grid{ display: grid; grid-template-columns: 1fr; gap: 10px 20px; margin-top: 12px; }
.detail-grid dt{ font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); font-weight: 700; margin-bottom: 2px;}
.detail-grid dd{ margin: 0; font-size: 0.87rem; color: var(--ink); }
.detail-grid .full{ grid-column: 1 / -1; }
.link-chip{
  display:inline-flex; align-items:center; gap:5px; font-size: 0.78rem; font-weight: 600;
  background: var(--teal-light); color: var(--teal-dark); padding: 4px 10px; border-radius: 999px;
  border: none; cursor: pointer; text-decoration: none;
}
.link-chip:hover{ background: var(--teal); color: #fff; }

/* ============================== REUNIONS ============================== */
.year-group{ margin-bottom: 22px; }
.year-group-head{
  display:flex; align-items:baseline; gap: 10px; margin-bottom: 10px;
  padding-bottom: 6px; border-bottom: 2px solid var(--border-strong);
}
.year-group-head h3{ font-family: var(--font-display); font-size: 1.15rem; }
.year-group-head .n{ color: var(--ink-faint); font-size: 0.82rem; }
.meeting-card{
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m);
  margin-bottom: 10px; box-shadow: var(--shadow-card);
}
.meeting-card summary{
  list-style:none; cursor:pointer; padding: 14px 16px;
  display:flex; flex-wrap: wrap; align-items:center; gap: 8px 14px;
}
.meeting-card summary::-webkit-details-marker{ display:none; }
.meeting-card summary:hover{ background: var(--surface-alt); }
.mc-id{
  font-family: var(--font-display); font-weight: 700; color: var(--teal-dark);
  background: var(--teal-light); border-radius: var(--radius-s); padding: 3px 9px; font-size: 0.85rem;
}
.mc-date{ font-weight: 600; font-size: 0.9rem; }
.mc-meta{ font-size: 0.78rem; color: var(--ink-muted); display:flex; gap: 10px; flex-wrap:wrap; }
.mc-tag{ font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--teal-dark); background: var(--teal-light); padding: 2px 8px; border-radius: 999px; }
.mc-agenda-count{ margin-left: auto; font-size: 0.76rem; color: var(--ink-faint); }
.meeting-card[open] summary{ border-bottom: 1px dashed var(--border); }
.meeting-detail{ padding: 12px 16px 16px; }
.agenda-list{ list-style:none; margin: 0; padding: 0; counter-reset: agenda; }
.agenda-list li{
  counter-increment: agenda; padding: 7px 0 7px 30px; position: relative; font-size: 0.88rem;
  border-top: 1px dotted var(--border);
}
.agenda-list li:first-child{ border-top: none; }
.agenda-list li::before{
  content: counter(agenda); position:absolute; left:0; top:7px;
  width: 20px; height: 20px; border-radius: 50%; background: var(--surface-alt); color: var(--ink-muted);
  font-size: 0.68rem; font-weight: 700; display:flex; align-items:center; justify-content:center;
}
.empty-note{ font-size: 0.85rem; color: var(--ink-faint); font-style: italic; padding: 6px 0; }
.related-exp{ margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--border); }
.related-exp h4{ font-size: 0.75rem; text-transform:uppercase; letter-spacing:0.05em; color: var(--ink-faint); margin-bottom:8px; }

/* ============================== MEMBRES ============================== */
.people-grid{ display: grid; gap: 14px; grid-template-columns: 1fr; }
.person-card{
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m);
  padding: 16px; box-shadow: var(--shadow-card); border-left: 4px solid var(--teal);
}
.person-card .role{ font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal-dark); }
.person-card .name{ font-family: var(--font-display); font-size: 1.08rem; font-weight: 600; margin: 3px 0 2px; }
.person-card .name.vacant{ color: var(--ink-faint); font-style: italic; font-weight: 500; }
.person-card .carrec{ font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 10px; }
.person-card .contact-line{ font-size: 0.8rem; display:flex; gap: 7px; align-items:baseline; margin-top: 4px; }
.person-card .contact-line .lbl{ color: var(--ink-faint); flex: 0 0 auto; min-width: 78px; font-size: 0.72rem; text-transform:uppercase; letter-spacing:0.04em; }
.person-card a{ word-break: break-all; }

/* ============================== GLOSSARI ============================== */
.legend-grid{ display: grid; gap: 10px; grid-template-columns: 1fr; }
.legend-item{ display:flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-top: 1px dotted var(--border); }
.legend-item:first-child{ border-top: none; }
